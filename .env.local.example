# Copy this file to .env.local and fill in your Supabase credentials.
# Get these from: Supabase project > Settings > API.

# Project URL (looks like https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (long string starting with eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — used by the cron route only. NEVER commit this anywhere
# public. Settings > API > "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=

# Cron secret — a random string you'll set in Vercel. The cron route verifies
# this header so only Vercel Cron can trigger ingestion.
CRON_SECRET=
